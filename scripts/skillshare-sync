#!/usr/bin/env node
'use strict';

const path = require('node:path');
const { synchronize } = require('../install/lib/skillshare-sync');

const options = { root: path.resolve(__dirname, '..'), home: require('node:os').homedir() };
options.configDir = path.join(process.env.XDG_CONFIG_HOME || path.join(options.home, '.config'), 'skillshare');
options.stateDir = path.join(process.env.XDG_STATE_HOME || path.join(options.home, '.local/state'), 'dotfiles');
for (const argument of process.argv.slice(2)) {
  if (argument === '--bootstrap') options.bootstrap = true;
  else if (argument === '--dry-run') options.dryRun = true;
  else if (argument === '--help') {
    process.stdout.write('Usage: scripts/skillshare-sync [--bootstrap] [--dry-run]\nReconcile declared external resources, then publish through Skillshare.\n');
    process.exit(0);
  } else {
    process.stderr.write(`Unknown argument: ${argument}\n`);
    process.exit(2);
  }
}
try {
  const result = synchronize(options);
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  if (result.mcp?.blocked?.length || result.external?.some(change => ['conflict', 'adoption-required'].includes(change.action))) process.exitCode = 1;
} catch (error) {
  process.stderr.write(`Skillshare sync failed: ${error.message}\n`);
  if (error.backupDir) process.stderr.write(`Recovery backup: ${error.backupDir}\n`);
  process.exitCode = 1;
}
