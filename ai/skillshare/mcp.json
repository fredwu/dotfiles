{
  "version": 1,
  "servers": {
    "chrome-devtools": {
      "transport": "stdio",
      "command": {
        "executable": "npx"
      },
      "args": [
        "-y",
        "chrome-devtools-mcp@1.12.0"
      ]
    },
    "context7": {
      "command": {
        "executable": "npx"
      },
      "args": [
        "-y",
        "@upstash/context7-mcp@4.4.4"
      ],
      "transport": "stdio"
    },
    "godot-ai": {
      "transport": "stdio",
      "command": {
        "executable": "uvx"
      },
      "args": [
        "--isolated",
        "--no-config",
        "--no-env-file",
        "--no-sources",
        "--no-build",
        "--index-strategy",
        "first-index",
        "--keyring-provider",
        "disabled",
        "--index",
        "https://pypi.org/simple",
        "--default-index",
        "https://pypi.org/simple",
        "--find-links",
        "https://pypi.org/simple/godot-ai/",
        "--link-mode",
        "copy",
        "--from",
        "godot-ai==4.3.0",
        "godot-ai",
        "attach",
        "--port",
        "8001",
        "--ws-port",
        "9501"
      ]
    },
    "playwright": {
      "transport": "stdio",
      "command": {
        "executable": "npx"
      },
      "args": [
        "-y",
        "@playwright/mcp@0.0.83"
      ]
    }
  }
}
