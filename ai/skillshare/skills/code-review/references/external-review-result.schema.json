{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "inspected_surface",
    "findings",
    "residual_risk"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "findings"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "enum": [
              "clean",
              "incomplete"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "findings",
        "clean",
        "incomplete"
      ]
    },
    "inspected_surface": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "priority",
          "confidence",
          "title",
          "location",
          "evidence",
          "impact",
          "remediation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^F[1-9][0-9]*$"
          },
          "priority": {
            "type": "string",
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "confidence": {
            "type": "integer",
            "minimum": 80,
            "maximum": 100
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "residual_risk": {
      "type": "string",
      "minLength": 1
    }
  }
}
