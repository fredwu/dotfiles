{
  "version": 1,
  "config": {
    "sources": {
      "skills": "${root}/ai/skillshare/skills",
      "mcp": "${mcpFile}"
    },
    "mode": "merge",
    "follow_source_links": true,
    "ignore": [".DS_Store", ".git/", "__pycache__/", ".system/", ".trash/", "synced/"],
    "targets": {
      "Mimo": {
        "skills": {"path": "${home}/.config/mimocode/skills", "mode": "merge"}
      },
      "antigravity": {
        "skills": {"path": "${home}/.gemini/config/skills", "mode": "merge", "exclude": ["mimo-browser-use__*"]}
      },
      "claude": {
        "skills": {"path": "${home}/.claude/skills", "mode": "merge", "exclude": ["mimo-browser-use__*"]}
      },
      "claude-gamma": {
        "agent": "claude",
        "config_dir": "${home}/.claude-gamma",
        "skills": {"path": "${home}/.claude-gamma/skills", "mode": "merge", "exclude": ["mimo-browser-use__*"]}
      },
      "codex": {
        "skills": {"path": "${home}/.codex/skills", "mode": "merge", "enabled": false}
      },
      "grok": {
        "skills": {"path": "${home}/.grok/skills", "mode": "merge", "enabled": false}
      },
      "universal": {
        "skills": {"path": "${home}/.agents/skills", "mode": "merge", "exclude": ["mimo-browser-use__*"]}
      }
    },
    "mcp": {"targets": ["claude", "codex", "opencode", "grok", "claude-desktop"]}
  },
  "executables": {"uvx": "uvx", "npx": "npx", "docker": "docker"},
  "external": []
}
